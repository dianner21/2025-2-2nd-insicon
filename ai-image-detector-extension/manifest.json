{
  "manifest_version": 3,
  "name": "AI Image Detector",
  "version": "1.5.0",
  "description": "Detects AI-generated images on web pages",

  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/image_utils.js", "utils/hash_utils.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  }
}
